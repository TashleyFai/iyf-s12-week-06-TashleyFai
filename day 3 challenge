// Day 3: Return a default user on 404 instead of throwing
const DEFAULT_USER = { id: 0, name: "Guest User", email: "guest@example.com" };

async function fetchUser(id) {
    try {
        const response = await fetch(`https://jsonplaceholder.typicode.com/users/${id}`);

        if (response.status === 404) {
            return DEFAULT_USER;
        }
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        return await response.json();
    } catch (error) {
        console.error("Failed to fetch user:", error.message);
        return DEFAULT_USER;
    }
}

async function main() {
    console.log("User 1:", await fetchUser(1));
    console.log("User 999:", await fetchUser(999)); // does not exist -> default user
}

main();
